From: Locietta <loia@users.noreply.github.com>
Date: Tue, 21 Jul 2026 11:20:00 +0800
Subject: [PATCH] drivers: hv: dxgkrnl: use flexible array for GPU wait payload

dxgkvmb_command_waitforsyncobjectfromgpu describes a variable-length
VMBus packet containing one fence value and one object handle per wait
object. The packet currently models the payload as a one-element
fence_values array and then writes both arrays through and beyond that
field.

With CONFIG_FORTIFY_SOURCE, modern GCC diagnoses both copies: multiple
fence values span the declared one-element field, and the object handle
copy starts with no space remaining in that field. Avoid hiding these
diagnostics behind direct stores or a compiler barrier. Model the whole
wire payload as an aligned flexible byte array instead.

The payload remains 8-byte aligned at offset 40. Removing the initial
u64 from sizeof(*command) and no longer subtracting it from cmd_size
also keeps the total VMBus packet size unchanged.
---
 drivers/hv/dxgkrnl/dxgvmbus.c | 5 ++---
 drivers/hv/dxgkrnl/dxgvmbus.h | 7 +++++--
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/hv/dxgkrnl/dxgvmbus.c b/drivers/hv/dxgkrnl/dxgvmbus.c
index 21e782e79..1e7261ee2 100644
--- a/drivers/hv/dxgkrnl/dxgvmbus.c
+++ b/drivers/hv/dxgkrnl/dxgvmbus.c
@@ -3069,8 +3069,7 @@ int dxgvmb_send_wait_sync_object_gpu(struct dxgprocess *process,
 	u32 fence_size = object_count * sizeof(u64);
 	u32 object_size = object_count * sizeof(struct d3dkmthandle);
 	u8 *current_pos;
-	u32 cmd_size = object_size + fence_size - sizeof(u64) +
-	    sizeof(struct dxgkvmb_command_waitforsyncobjectfromgpu);
+	u32 cmd_size = struct_size(command, payload, fence_size + object_size);
 	struct dxgvmbusmsg msg = {.hdr = NULL};
 	struct dxgglobal *dxgglobal = dxggbl();
 
@@ -3089,7 +3088,7 @@ int dxgvmb_send_wait_sync_object_gpu(struct dxgprocess *process,
 	command->context = context;
 	command->object_count = object_count;
 	command->legacy_fence_object = legacy_fence;
-	current_pos = (u8 *) command->fence_values;
+	current_pos = command->payload;
 	memcpy(current_pos, fences, fence_size);
 	current_pos += fence_size;
 	memcpy(current_pos, objects, object_size);
diff --git a/drivers/hv/dxgkrnl/dxgvmbus.h b/drivers/hv/dxgkrnl/dxgvmbus.h
index a7e625b2f..ef44f8e28 100644
--- a/drivers/hv/dxgkrnl/dxgvmbus.h
+++ b/drivers/hv/dxgkrnl/dxgvmbus.h
@@ -722,8 +722,11 @@ struct dxgkvmb_command_waitforsyncobjectfromgpu {
 	/* Must be 1 when bLegacyFenceObject is TRUE */
 	u32				object_count;
 	bool				legacy_fence_object;
-	u64				fence_values[1];
-	/* struct d3dkmthandle ObjectHandles[object_count] */
+	/*
+	 * u64 FenceValues[object_count]
+	 * struct d3dkmthandle ObjectHandles[object_count]
+	 */
+	u8				payload[] __aligned(8);
 };
 
 struct dxgkvmb_command_lock2 {
-- 
2.54.0
